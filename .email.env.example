# Copy to .email.env and chmod 600 .email.env. Sourced as shell code.
# Enable Google 2-Step Verification, then create an app password (not your login password).
GMAIL_ADDRESS=''
GMAIL_APP_PASSWORD=''
# Optional: blank sends the picks to GMAIL_ADDRESS itself.
UFC_EMAIL_TO=''
# Optional interpreter override (otherwise .venv, then existing Anaconda fallback).
# UFC_PYTHON='/absolute/path/to/python'
# Optional absolute paths for private receipts and the manual hold switch.
# UFC_EMAIL_STATE_DIR='/absolute/path/to/private/email_delivery'
# UFC_EMAIL_HOLD_FILE='/absolute/path/to/private/email.hold'
