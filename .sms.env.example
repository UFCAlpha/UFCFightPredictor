# Copy to .sms.env and chmod 600 .sms.env. This file is sourced as shell code.
# Use a Twilio SMS-capable sender and an E.164 recipient (+country code + number).
TWILIO_ACCOUNT_SID=''
TWILIO_AUTH_TOKEN=''
TWILIO_FROM_NUMBER=''
UFC_SMS_TO=''
# Optional: interpreter override (otherwise .venv, then existing Anaconda fallback).
# UFC_PYTHON='/absolute/path/to/python'
# Optional: override paths; use absolute paths when running under a scheduler.
# UFC_SMS_STATE_DIR='/absolute/path/to/private/sms_delivery'
# UFC_SMS_HOLD_FILE='/absolute/path/to/private/sms.hold'
